              {
                "text": "34",
                "rowSpan": "1",
                "colSpan": "1"
              },
              {
                "text": "ロシア",
                "rowSpan": "1",
                "colSpan": "1"
              },
              {
                "text": "",
                "rowSpan": "1",
                "colSpan": "1"
              },
              {
                "text": "Nga",
                "rowSpan": "1",
                "colSpan": "1"
              }
