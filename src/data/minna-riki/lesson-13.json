                "text": "ていしょく",
                "rowSpan": "1",
                "colSpan": "1"
              },
              {
                "text": "",
                "rowSpan": "1",
                "colSpan": "1"
              },
              {
                "text": "Cơm suất, cơm phần",
                "rowSpan": "1",
                "colSpan": "1"
