              {
                "text": "そうしましょう。",
                "rowSpan": "1",
                "colSpan": "1"
              },
              {
                "text": "",
                "rowSpan": "1",
                "colSpan": "1"
              },
              {
                "text": "Nhất trí./ Chúng ta thống nhất như thế.",
                "rowSpan": "1",
                "colSpan": "1"
